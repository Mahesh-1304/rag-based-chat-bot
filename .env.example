# ============================================================
# RAG Document Chatbot — Environment Variables
# Copy this file to .env and edit as needed.
# ============================================================

# ---- Ollama (local LLM — free, no API key needed) ----
# Make sure Ollama is running:  ollama serve
# Pull your model first:        ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest

# ---- Embedding Model (runs locally via sentence-transformers) ----
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_VECTOR_DIM=384

# ---- Chunking ----
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# ---- Vector Store ----
VECTOR_STORE_TYPE=flat    # flat | hnsw | ivf

# ---- Retriever ----
RETRIEVER_TOP_K=3
RETRIEVER_SCORE_THRESHOLD=0.1

# ---- LLM Parameters ----
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=256

# ---- API Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ---- Logging ----
LOG_LEVEL=INFO
